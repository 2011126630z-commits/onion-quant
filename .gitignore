# --- 依赖与构建产物(不入库) ---
node_modules/
.build/
build/
dist/
.gradle/
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/app/src/main/assets/public/
android/local.properties
*.aab
*.iml

# --- 交付归档 tar(不入库;仓库只保留 /apk 下的正式 APK) ---
*.tar

# --- 签名与凭据绝不入库 ---
*.keystore
*.jks
.env
.env.*

# --- 历史误操作产生的杂物文件(只忽略,不删除磁盘内容) ---
(i-13+k)+'
console.log(d.slice(0
m\[1\]\)
openCloseSheet
/i
/x
tools/_tmp_seam.mjs

# --- 旧 Sites 托管配置(保留在磁盘,不入仓库) ---
.openai/

# 注意:这里【故意不写】全局 *.apk —— /apk/app-latest.apk 必须可以被提交。
# 如需再收紧,必须使用 "*.apk" + "!/apk/*.apk" 成对规则。
